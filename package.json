{
  "name": "rnmrs",
  "version": "0.1.1",
  "description": "Interactive release CLI for React Native apps: Fastlane binaries and RevoPush OTA updates",
  "keywords": [
    "react-native",
    "release",
    "fastlane",
    "revopush",
    "codepush",
    "ota",
    "cli"
  ],
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minkaungkyaw-yomafleet/rn-mobile-release-script.git"
  },
  "bin": {
    "rnmrs": "bin/rnmrs.js"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=18",
    "bun": ">=1.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:native": "bun scripts/build-native.js",
    "build:native:current": "bun scripts/build-native.js --current",
    "test": "bun test",
    "test:native": "cd native && go vet ./... && go test ./...",
    "check": "bun run test && bun run test:native",
    "prepack": "bun run build:native",
    "prepublishOnly": "node -e \"if(!process.env.CI){console.error('Publish from CI only: push a v* tag (see CONTRIBUTING.md).');process.exit(1)}\""
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "chalk": "^5.6.2",
    "commander": "^12.1.0",
    "semver": "^7.8.6",
    "yaml": "^2.9.1"
  }
}
